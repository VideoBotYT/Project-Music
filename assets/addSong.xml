<dialog title="Add Song" width="640" height="480">
    <vbox width="100%" height="100%">
        <hbox>
            <label text="Name:"/>
            <textfield placeholder="Example Song" id="songName"/>
        </hbox>
        <scrollView width="100%" height="100%" contentHeight="100%" contentWidth="100%">
            <vbox width="100%" height="100%" id="fileList"/>
        </scrollView>
        <button id="addFile" text="Add File"/>
    </vbox>
</dialog>